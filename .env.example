# Copy to .env and fill in. .env is gitignored.

# MySQL (the db volume keeps whatever values it was first initialised with)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio
MYSQL_PASSWORD=change-me

# Admin panel (admin/login.php, admin.php)
ADMIN_USERNAME=admin
# Generate with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
# Keep the single quotes: bcrypt hashes contain $ which Compose would otherwise expand
ADMIN_PASSWORD_HASH='$2y$10$replace-with-generated-hash'
